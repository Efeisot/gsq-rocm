+def _safe_cholesky(X, upper=False):
+    """Cholesky for a symmetric matrix with a ROCm-safe fallback.
+
+    ``X^T X`` is symmetric analytically, but fp32 GEMM on gfx1200 leaves a
+    small asymmetry that rocSOLVER can reject as non-PD.  Symmetrize first and
+    retry in fp64 if the fp32 factorization still fails.
+    """
+    X = (X + X.transpose(-1, -2)) * 0.5
+    try:
+        return torch.linalg.cholesky(X, upper=upper)
+    except torch._C._LinAlgError:
+        factor = torch.linalg.cholesky(X.double(), upper=upper)
+        return factor.to(X.dtype)
+
